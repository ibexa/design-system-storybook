{% extends '@IbexaDesignSystemStorybook/themes/standard/storybook/base_preview.html.twig' %}

{% block component %}
    <twig:ibexa:chip {{ ...args }}>
        {{ content|raw }}
    </twig:ibexa:chip>
{% endblock component %}

{% block scripts %}
    {{ parent() }}

    const deleteBtnElement = document.querySelector('.ids-chip__delete');

    deleteBtnElement.addEventListener('click', (event) => { const eventClone = { ...event };

    window.parent?.postMessage({ method: 'onClick', args: [eventClone], },"*"); });
{% endblock scripts %}
