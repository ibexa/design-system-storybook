{% extends '@IbexaDesignSystemStorybook/themes/standard/storybook/base_preview.html.twig' %}

{% block component %}
    {% set html_for = args.htmlFor %}
    {% set args = args|filter((v, k) => k != 'htmlFor') %}

    <twig:ibexa:label :for="html_for" {{ ...args }}>
        {{ content|raw }}
    </twig:ibexa:label>
{% endblock component %}
