{% extends '@IbexaDesignSystemStorybook/themes/standard/storybook/base_preview.html.twig' %}

{% block component %}
    {% set label = args.label|default('') %}
    {% set args = args|filter((v, k) => k != 'label') %}

    <twig:ibexa:checkbox:field {{ ...args }}>
        {{- label -}}
    </twig:ibexa:checkbox:field>
{% endblock component %}
