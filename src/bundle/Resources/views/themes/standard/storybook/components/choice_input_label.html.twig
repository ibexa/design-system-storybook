{% extends '@IbexaDesignSystemStorybook/themes/standard/storybook/base_preview.html.twig' %}

{% block component %}
    {% set html_for = args.html_for %}
    {% set args = args|filter((v, k) => k != 'html_for') %}
    {% set content_block -%}
        {{ content|raw }}
    {%- endset %}

    <twig:ibexa:ChoiceInputLabel :for="html_for" {{ ...args }}>
        {{- content_block -}}
    </twig:ibexa:ChoiceInputLabel>
{% endblock component %}
