{% set header = args.header %}
{% set args = args|filter((v, k) => k != 'header') %}

<div style="width: 800px; min-height: 300px">
    <twig:ibexa:Accordion {{ ...args }}>
        {% block header %}
            {{- header|raw -}}
        {% endblock header %}

        {{- content|raw -}}
    </twig:ibexa:Accordion>
</div>
