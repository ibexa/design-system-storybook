{% extends '@IbexaDesignSystemStorybook/themes/standard/storybook/base_preview.html.twig' %}

{% block component %}
    {% set header = args.header %}
    {% set args = args|filter((v, k) => k != 'header') %}

    <div style="width: 800px; min-height: 300px">
        <twig:ibexa:Accordion {{ ...args }}>
            <twig:block name="header">
                {{ header|raw }}
            </twig:block>

            {{- content|raw -}}
        </twig:ibexa:Accordion>
    </div>
{% endblock component %}
