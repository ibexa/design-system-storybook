<twig:ibexa:Expander {{ ...args }} />

<script>
    const togglerElement = document.querySelector('.ids-expander');

    togglerElement.addEventListener('ids:component:initialized', ({ detail }) => { const { component } = detail;

    component.expandHandler = (isExpanded) => { window.parent?.postMessage({ method: 'onClick', args: [isExpanded], },"*"); }; });
</script>
