{% if content == null %}
    <twig:ibexa:ButtonIcon {{ ...args }} />
{% else %}
    <twig:ibexa:Button {{ ...args }}>
        {{ content }}
    </twig:ibexa:Button>
{% endif %}

<script>
    const btnElement = document.querySelector('.ids-btn');

    btnElement.addEventListener('click', (event) => { const eventClone = { ...event };

    window.parent?.postMessage({ method: 'onClick', args: [eventClone], },"*"); });
</script>
