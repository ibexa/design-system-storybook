{% extends '@IbexaDesignSystemStorybook/themes/standard/storybook/base_preview.html.twig' %}

{% block component %}
    <twig:ibexa:button {{ ...args }}>
        {{ content|raw }}
    </twig:ibexa:button>
{% endblock component %}

{% block scripts %}
    {{ parent() }}

    <script type="text/javascript">
        const btnElement = document.querySelector('.ids-btn');

        btnElement.addEventListener('click', (event) => {
            const eventClone = { ...event };

            window.parent?.postMessage({ method: 'onClick', args: [eventClone], },"*");
        });
    </script>
{% endblock scripts %}
