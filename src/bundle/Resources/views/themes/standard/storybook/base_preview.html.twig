<!DOCTYPE html>
<html>
    <head>
        {% block head %}
            {{ encore_entry_script_tags('ibexa-design-system-storybook-js', null, 'ibexa') }}
            {{ encore_entry_link_tags('ibexa-design-system-storybook-css', null, 'ibexa') }}
        {% endblock head %}
    </head>
    <body>
        <div class="component-preview" style="display: inline-block">
            {% block component %}
                {{ component('ibexa:' ~ component_id, args) }}
            {% endblock component %}
        </div>

        <script type="text/javascript">
            {% block scripts %}
            {% endblock scripts %}
        </script>
    </body>
</html>
